{
  "name": "xiezi",
  "private": true,
  "version": "1.0.0",
  "description": "写字本 — Chinese writing, listening, speaking, reading and vocabulary practice (PWA)",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "vite build",
    "preview": "vite preview --host",
    "test": "vitest run",
    "emulators": "firebase emulators:start --only auth,firestore --project demo-xiezi",
    "dev:emulator": "vite --mode emulator --host 127.0.0.1 --port 5174 --strictPort",
    "test:sync": "node scripts/e2e/sync.mjs",
    "test:screens": "node scripts/e2e/screens.mjs",
    "sync:report": "node --use-env-proxy scripts/sync-report.mjs",
    "gen:data": "node scripts/gen-data.mjs",
    "gen:font": "python scripts/subset-font.py",
    "gen:audio": "python scripts/gen-audio.py",
    "gen:icons": "node scripts/gen-icons.mjs",
    "add-lesson": "node scripts/add-lesson.mjs",
    "check": "node scripts/check-data.mjs",
    "setup:firebase": "node scripts/setup-firebase.mjs"
  },
  "dependencies": {
    "@fontsource/atkinson-hyperlegible": "^5.3.0",
    "firebase": "^13.1.0",
    "hanzi-writer": "^3.7.3"
  },
  "devDependencies": {
    "hanzi-writer-data": "^2.0.1",
    "sharp": "^0.35.5",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.5"
  }
}
