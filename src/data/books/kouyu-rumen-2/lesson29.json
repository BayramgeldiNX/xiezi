  "grammar": [
    {
      "point": "被 / 叫 / 让 passive",
      "en": "Subject (what is affected) + 被 / 叫 / 让 + doer + verb + result. 被 is more bookish, 叫 and 让 are spoken. The verb needs a result or other element, and the sentence often reports something unwelcome.",
      "drills": [
        {
          "q": "我的钱包___人拿走了。",
          "options": [
            "被",
            "对",
            "比",
            "跟"
          ],
          "answer": 0,
          "en": "My wallet was taken by someone."
        },
        {
          "q": "我的面包___小猫吃了。",
          "options": [
            "让",
            "在",
            "比",
            "对"
          ],
          "answer": 0,
          "en": "My bread was eaten by the cat."
        },
        {
          "q": "我___老师批评了一顿。",
          "options": [
            "叫",
            "对",
            "在",
            "比"
          ],
          "answer": 0,
          "en": "I got a telling-off from the teacher."
        },
        {
          "q": "我的电脑被他___坏了。",
          "options": [
            "摔",
            "给",
            "把",
            "被"
          ],
          "answer": 0,
          "en": "My computer was broken when he dropped it."
        }
      ]
    },
    {
      "point": "Where things go in a passive",
      "en": "Negatives and 可能 / 想 go before 被 / 叫 / 让. If the doer is unknown or unimportant, 被 can come straight before the verb, or 人 can stand for \"someone\".",
      "drills": [
        {
          "q": "我的伞___被朋友拿走。",
          "options": [
            "没",
            "在",
            "把",
            "对"
          ],
          "answer": 0,
          "en": "My umbrella wasn't taken by a friend."
        },
        {
          "q": "蛋糕都___吃完了。",
          "options": [
            "被",
            "把",
            "对",
            "比"
          ],
          "answer": 0,
          "en": "The cake has all been eaten."
        },
        {
          "q": "他___被老师批评了。",
          "options": [
            "没",
            "把",
            "在",
            "对"
          ],
          "answer": 0,
          "en": "He wasn't criticized by the teacher."
        },
        {
          "q": "我的自行车可能___人骑走了。",
          "options": [
            "让",
            "对",
            "在",
            "比"
          ],
          "answer": 0,
          "en": "Someone may have ridden off on my bike."
        }
      ]
