  "grammar": [
    {
      "point": "把 + object + verb + 到 / 在 / 给 / 成",
      "en": "A 把-sentence puts the thing being handled before the verb and says what happens to it. 到 = it ends up at a place, 在 = it is put somewhere, 给 = it is handed to someone, 成 = it turns into something.",
      "drills": [
        {
          "q": "请把这封信寄___上海。",
          "options": [
            "到",
            "在",
            "给",
            "成"
          ],
          "answer": 0,
          "en": "Please post this letter to Shanghai."
        },
        {
          "q": "我把手机放___桌子上了。",
          "options": [
            "在",
            "给",
            "成",
            "过"
          ],
          "answer": 0,
          "en": "I put my phone on the table."
        },
        {
          "q": "我把他当___我哥哥了。",
          "options": [
            "成",
            "在",
            "到",
            "给"
          ],
          "answer": 0,
          "en": "I took him for my older brother."
        },
        {
          "q": "我把照片发___妈妈了。",
          "options": [
            "给",
            "成",
            "在",
            "的"
          ],
          "answer": 0,
          "en": "I sent the photo to Mum."
        }
      ]
    },
    {
      "point": "The verb needs something after it",
      "en": "The verb in a 把-sentence is an action that does something to the object, and it can't stand bare. 有, 是 and 在 can't be used. Negatives and 想 / 能 / 快 go before 把.",
